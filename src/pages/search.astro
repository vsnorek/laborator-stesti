---
export const prerender = false;

import { search, getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// Ranking and matching come from the FTS index rather than substring
// comparisons in JS: results arrive ordered by relevance and the index
// handles tokenization.
const { items: hits } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };

// search() returns id/title/snippet only, so the cards still need the
// collection for image, date and reading time. entry.id is the slug and
// entry.data.id is the database ULID; search() may return either.
const { entries: allPosts } = await getEmDashCollection("posts");

const results = hits
	.map((hit) => ({
		post: allPosts.find(
			(post) =>
				String(post.id) === String(hit.id) ||
				String(post.data.id) === String(hit.id) ||
				String(post.id) === String(hit.slug),
		),
		snippet: hit.snippet,
	}))
	.filter((row) => row.post !== undefined);
---

<Base title={query ? `Hledání: ${query}` : "Hledání"} description="Hledání v článcích">
	<section class="search-page">
		<h1 class="search-title">Hledání</h1>

		<form method="get" action="/search" class="search-form">
			<input type="search" name="q" value={query} placeholder="Hledat v článcích…" class="search-input" autofocus />
			<button type="submit" class="search-button">Hledat</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `Pro „${query}“ nebyly nalezeny žádné výsledky.`
						: `${results.length} ${results.length === 1 ? "výsledek" : results.length >= 2 && results.length <= 4 ? "výsledky" : "výsledků"} pro „${query}“`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<div class="search-results">
					{results.map((result) => (
						<PostCard title={result.post.data.title} snippet={result.snippet} excerpt={result.post.data.excerpt} featuredImage={result.post.data.featured_image} href={`/posts/${result.post.id}`} date={result.post.data.publishedAt ?? undefined} readingTime={getReadingTime(result.post.data.content)} />
					))}
				</div>
			)
		}

		{!query && <p class="search-hint">Zadejte hledaný výraz.</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.search-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 500;
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.search-summary {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.search-hint {
		color: var(--color-muted);
	}

	.search-results {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-8);
	}
</style>
